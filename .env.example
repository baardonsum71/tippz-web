# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tippz-print
# Public base URL for objects, e.g. https://pub-xxxxx.r2.dev or https://files.tippz.app
R2_PUBLIC_BASE_URL=

# Gelato
GELATO_API_KEY=
# Optional overrides — verify in Gelato Product Catalog
GELATO_STICKER_PRODUCT_UID=stickers_square_contour-cut_polypropylene_3x3_inch
GELATO_CARD_PRODUCT_UID=cards_pf_bb_pt_350-gsm-coated-silk_cl_4-0_ct_matt-protection_prt_1-1_hor
GELATO_STICKER_QUANTITY=5
GELATO_CARD_QUANTITY=20

# RevenueCat (secret API key from RevenueCat dashboard)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=Tippz Pro

# Optional shared secret. If set, apps must send Authorization: Bearer <secret>
STARTER_PACK_API_SECRET=

# Tip landing base used inside the printed QR
TIPPZ_TIP_BASE_URL=https://tippz.app/tip
